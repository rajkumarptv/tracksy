# Server
PORT=5000
NODE_ENV=development

# PostgreSQL Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=tracksy_db
DB_USER=postgres
DB_PASSWORD=your_password_here

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRES_IN=7d

# CORS
CLIENT_URL=http://localhost:3000

# Gemini (receipt scanning) — free key from https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ── Supabase REST mode (alternative to DB_* / DATABASE_URL) ──
# Run backend/supabase/exec_sql.sql once in the Supabase SQL editor, then:
# DB_MODE=api
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_SERVICE_KEY=<service_role or sb_secret key>

# Google sign-in (Google Cloud Console → APIs & Services → Credentials → OAuth client ID, type "Web application").
# Authorized redirect URI: <API_URL>/api/auth/google/callback  (for example https://your-api.onrender.com/api/auth/google/callback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Google through Supabase Auth: set to "supabase" and the Google button uses your Supabase project
# (Supabase dashboard: Authentication > Providers > Google, and add FRONTEND_URL/auth/callback to Authentication > URL Configuration > Redirect URLs).
# GOOGLE_AUTH=supabase
